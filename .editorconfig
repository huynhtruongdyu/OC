root = true

###############################
# Global settings
###############################

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

###############################
# C# files
###############################

[*.cs]

#### Formatting ####
csharp_new_line_before_open_brace = none

#### Namespace style (file-scoped) ####
csharp_style_namespace_declarations = file_scoped:warning

#### Using directives ####
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

#### var usage ####
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

#### Expression-bodied members ####
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

#### Nullability ####
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

#### Code style ####
dotnet_style_readonly_field = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion

#### Braces ####
csharp_prefer_braces = true:suggestion

###############################
# Naming rules (basic)
###############################

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.properties_should_be_pascal_case.severity = suggestion

###############################
# XML files
###############################

# S2094: Classes should not be empty
dotnet_diagnostic.CA1515.severity = suggestion
dotnet_diagnostic.CA1812.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1852.severity = suggestion
dotnet_diagnostic.CA5394.severity = suggestion
dotnet_diagnostic.CS0050.severity = suggestion
dotnet_diagnostic.S2094.severity = suggestion
dotnet_diagnostic.S6960.severity = suggestion
dotnet_diagnostic.S6966.severity = suggestion


[*.xml]
indent_size = 2

###############################
# JSON files
###############################

[*.json]
indent_size = 2

###############################
# Markdown
###############################

[*.md]
trim_trailing_whitespace = false
